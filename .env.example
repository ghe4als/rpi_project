# Copy to .env and fill in. .env is gitignored.
WIFI_SSID="your-ssid"
WIFI_PSK="your-wifi-password"
WIFI_COUNTRY="US"
PI_USERNAME="pi"
PI_PASSWORD="plaintext-password-will-be-hashed-at-render"
TIMEZONE="America/Los_Angeles"
LOCALE="en_US.UTF-8"
KEYMAP="us"

# Role to install on first boot (post-network). One of: base, security-camera, touchscreen, tailscale, monitor, netdata-child, travel-router, copyparty
ROLE="base"

# touchscreen role only: SPI panel overlay + touch params.
# Cheap 3.5" SPI clones don't all use the same controller. Try in this order
# until /dev/fb1 (or /dev/dri/card1) shows up AND pixels reach the LCD:
#   tinylcd35   - generic ILI9486-ish, fbtft, /dev/fb1, broadest clone support
#   piscreen    - OzzMaker, fbtft (drop ",drm" for fbtft, add ",drm" for KMS)
#   piscreen2r  - OzzMaker resistive variant, KMS-capable
#   pitft35-resistive - Adafruit HX8357D, KMS-capable
#   mhs35       - SuziPi/MHS vendor (NOT in mainline overlays - 3rd-party only)
TOUCHSCREEN_OVERLAY="tinylcd35"
TOUCHSCREEN_OVERLAY_PARAMS="rotate=90,fps=30,touch,touchgpio=17"
TOUCHSCREEN_TOUCH_OVERLAY="ads7846"
TOUCHSCREEN_TOUCH_PARAMS="cs=1,penirq=17,speed=1000000,swapxy=1,invx=1"

# All roles: NATS broker for node self-announcement.
NATS_URL="nats://192.168.0.151:4222"

# monitor + netdata-child roles: Netdata parent/child streaming.
# Generate ONE shared API key (a UUID) and use the same value on the monitor
# Pi (parent) and every fleet Pi (child). The key is staged via role.env.
#   uuidgen | pbcopy   # macOS
NETDATA_STREAM_API_KEY=""
NETDATA_PARENT_HOST=""     # optional; defaults to host extracted from NATS_URL

# tailscale role only: remote-access VPN subnet router.
# Generate a one-time auth key at https://login.tailscale.com/admin/settings/keys
# (Auth keys -> Generate auth key -> reusable: off, ephemeral: off, tags: optional).
# The key is staged to the Pi via role.env and scrubbed after first `tailscale up`.
TAILSCALE_AUTH_KEY=""
TAILSCALE_SUBNET="192.168.0.0/24"
TAILSCALE_HOSTNAME=""        # optional; defaults to the Pi's hostname
TAILSCALE_UP_TIMEOUT_SEC="120"

# copyparty role only: file server bound to the Tailscale interface ONLY.
# Requires ROLE=copyparty (pulls in tailscale via role.deps). The Pi must have
# joined the tailnet (approve node at https://login.tailscale.com/admin/machines)
# before copyparty.service can bind its Tailscale IP.
# AUTH-ONLY posture: COPYPARTY_ACCOUNTS is REQUIRED (any value missing it fails
# the install) — all access needs a login; no anonymous anything.
COPYPARTY_PORT="3923"          # TCP port on the Tailscale interface
COPYPARTY_DIR=""               # optional; default /var/lib/copyparty (share root)
COPYPARTY_ACCOUNTS="user:change-this-pass"  # REQUIRED; user:pass pairs, comma-sep
                               # first pair = read/write owner; later pairs are
                               # read-only watchers until granted :rw,<user> in
                               # /etc/copyparty/args on the Pi
# Optional at-rest encryption of the whole share (gocryptfs under COPYPARTY_DIR).
# COPYPARTY_CRYPT=1 requires COPYPARTY_CRYPT_KEY; the key is staged to the
# bootfs as copyparty.crypt.key (0600 root). Tradeoff: a thief who takes the
# WHOLE card gets ciphertext plus this key (obfuscation-grade, not absolute) —
# stronger options (USB-stick keyfile, passphrase-at-boot) in
# roles/copyparty/README.md. Unset/0 = plain share, zero behavior change.
COPYPARTY_CRYPT="0"
COPYPARTY_CRYPT_KEY=""

# travel-router role only: a private WiFi AP the Pi always serves, with the
# USB network adapter you plug in as the WAN (hotel wifi / wired jack / none).
# AP_SSID + AP_PSK are staged via role.env; PSK must be 8-63 chars of
# A-Za-z0-9._- (chars are validated again in install.sh).
# WIFI_SSID/WIFI_PSK are also passed to the travel-router role and are used
# as the FIRST WAN (hotel) profile on first boot.
TRAVELROUTER_AP_SSID=""                          # required; the travel network name devices join
TRAVELROUTER_AP_PSK=""                           # required, 8-63 chars; never logged
TRAVELROUTER_AP_CHANNEL="6"
TRAVELROUTER_AP_COUNTRY="US"                     # ISO 3166-1 alpha-2, used for iw reg set
TRAVELROUTER_AP_SECURITY="wpa2"                  # wpa2 (default) | wpa3-transition | wpa3; wpa3* needs an SAE-capable AP radio (fail-loud at install)
TRAVELROUTER_LAN_CIDR="192.168.50.1/24"
TRAVELROUTER_DHCP_RANGE="192.168.50.100,192.168.50.200,12h"
TRAVELROUTER_WAN_PREFER="auto"                   # auto|wifi|ethernet|none
TRAVELROUTER_STATUS_PORT="80"
# Admin-write PIN — REQUIRED. Second factor on every admin write (admin page).
# 4-12 chars of A-Za-z0-9 (deliberately phone-keyboard-friendly).
TRAVELROUTER_SETUP_PIN="1234"
# Admin password for the admin page — REQUIRED. Gates the /admin login and every change,
# alongside the PIN above. >=8 printable-ASCII chars (avoid | \ $ & which break
# the sed renders).
TRAVELROUTER_ADMIN_PSK=""
# Default PSK candidates for the travel-router's "try saved passwords"
# feature (comma-separated; tried when a scanned network matches no saved
# candidate). Optional — leave empty to disable.
TRAVELROUTER_DEFAULT_PSKS=""

# Common-SSID pool seed for the travel AP (SC-wave; optional). Repo-root
# file `.ssid_common`, one SSID per line, '#' comments and blank lines ok.
# Provisioned at install; while non-empty the admin page's Random name
# draws from it and the AP-settings card offers the entries to pick from.
# Leave unset to keep the random no-lookalike mint. Re-running install
# WITHOUT the file clears the pool; WITH it, rebuilds it. Gitignored.

# chicken-cam role only: piChick AI service config.
# Ollama inference URL on LAN. COOP_* defaults are Sunnyvale CA.
OLLAMA_URL="http://192.168.0.X:11434"
OLLAMA_MODEL="llava:7b"
COOP_LAT="37.37"
COOP_LON="-122.04"
COOP_TZ="America/Los_Angeles"
MOTION_PORT="8081"
