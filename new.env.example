# Base Setup for RPI's
WIFI_SSID="your-ssid"
WIFI_PSK="your-wifi-password"
WIFI_COUNTRY="US"
PI_USERNAME=""
PI_PASSWORD=""
TIMEZONE="America/Los_Angeles"
LOCALE="en_US.UTF-8"
KEYMAP="us"

# CopyParty Role
COPYPARTY_ACCOUNTS="al:changeme,backup:strongpass"

# Tailscale Role
TAILSCALE_AUTH_KEY=""

# Travel-router role only
TRAVELROUTER_AP_SSID="travel-router"
TRAVELROUTER_AP_PSK=""
TRAVELROUTER_SETUP_PIN=""
TRAVELROUTER_ADMIN_PSK=""

# Chicken-cam role: piChick AI service (NATS + Ollama both on 192.168.0.76)
NATS_URL="nats://192.168.0.76:4222"
OLLAMA_URL="http://192.168.0.76:11434"
OLLAMA_MODEL=llama3.2-vision:11b
COOP_LAT="37.37"
COOP_LON="-122.04"
COOP_TZ="America/Los_Angeles"
MOTION_PORT="8081"

#Touchscreen Settings
TOUCHSCREEN_DRIVER="kedei-fbcp"
TOUCHSCREEN_OVERLAY="tinylcd35"
TOUCHSCREEN_OVERLAY_PARAMS="rotate=90,speed=32000000"
TOUCHSCREEN_TOUCH_OVERLAY="ads7846"
TOUCHSCREEN_TOUCH_PARAMS="cs=1,penirq=17,speed=1000000,swapxy=1,invx=1"

