# Travel-router LAN DHCP/DNS config (dnsmasq). Rendered once by install.sh.
# Serves the private LAN and acts as the Pi's own DNS for connected clients.
interface=__LAN_INTERFACE__
bind-dynamic

# DNS for DHCP clients: dnsmasq advertises itself as the DNS server to
# DHCP clients by default (option 6 = this host), so no explicit
# dhcp-option line is needed.
domain-needed

# DHCP range for travel-network clients.
dhcp-range=__DHCP_RANGE__

# No-hosts is intentionally NOT set: keep /etc/hosts entries resolvable.

# DHCP connection log: each join/renew (hostname, MAC, IP) goes to a
# dedicated file, NOT journald. Bounded by /etc/logrotate.d/travel-router-dhcp.
log-dhcp
log-facility=/var/log/travel-router/dhcp.log
