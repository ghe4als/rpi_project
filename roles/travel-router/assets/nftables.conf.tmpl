flush ruleset

# Travel-router nftables ruleset. Rendered per-run by wan-select.sh.
# flush is REQUIRED: the 30s timer re-runs `nft -f` here. Without flush,
# re-declaring `table inet travel_router` fails with "file exists" and a
# WAN change never applies. With flush the whole ruleset swaps atomically.

table inet travel_router {
table inet travel_router {
    # Blocked devices (admin block list). wan-select.sh renders the block
    # file (one MAC per line) into the full-line marker below: populated ->
    # an `elements = { .. }` line, empty/absent file -> the marker line is
    # DELETED (a set with no elements line; never an empty `{ }` list).
    # A blocked MAC drops at the TOP of input AND forward — BEFORE the
    # established-connection accepts, or a just-blocked client would keep
    # its live sessions (nft is first-match).
    set blocked_macs {
        type ether_addr
        __BLOCKED_MACS_ELEM__
    }

    chain input {
        type filter hook input priority filter; policy drop;
        # Loopback + established/related return traffic.
        iifname "lo" accept
        iifname "__LAN_INTERFACE__" ether saddr @blocked_macs drop
        ct state established,related accept
        # DHCP/DNS + HTTP status page + SSH for LAN clients.
        iifname "__LAN_INTERFACE__" udp dport { 53, 67 } accept
        iifname "__LAN_INTERFACE__" tcp dport { 53, 80, 22 } accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        # Return traffic for LAN-originated flows.
        iifname "__LAN_INTERFACE__" ether saddr @blocked_macs drop
        ct state established,related accept
        # Outbound LAN -> WAN (routed modes only). In standalone mode
        # wan-select STRIPS this rule line (grep -v on the rendered WAN
        # placeholder), leaving only this comment header, so the file stays
        # syntactically valid with no dangling placeholders.
        iifname "__LAN_INTERFACE__" oifname "__WAN_INTERFACE__" accept
    }

    chain postrouting {
        type nat hook postrouting priority srcnat;
        # NAT LAN -> WAN (routed modes only). In standalone mode wan-select
        # STRIPS this rule line (grep -v), leaving the comment header; the
        # chain stays valid with an empty body.
        oifname "__WAN_INTERFACE__" masquerade
    }
}
