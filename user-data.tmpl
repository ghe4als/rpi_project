#cloud-config
# Trixie cloud-init first-boot config. Rendered from .env by provision.sh.
#
# Hostname comes from the CPU serial via bootcmd (runs in init stage,
# BEFORE cc_set_hostname). We deliberately omit the top-level `hostname:`
# key so cc_set_hostname has nothing to overwrite our value with. We also
# leave preserve_hostname unset (default behaviour) - cloud-init will
# preserve whatever we wrote.

locale: ${LOCALE}
timezone: ${TIMEZONE}

keyboard:
  model: pc105
  layout: ${KEYMAP}

ssh_pwauth: true
chpasswd:
  expire: false

users:
  - name: ${PI_USERNAME}
    gecos: "Pi user"
    groups: users,adm,dialout,audio,netdev,video,plugdev,cdrom,games,input,gpio,spi,i2c,render,sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    passwd: ${PI_PASSWORD_HASH}
    ssh_authorized_keys:
${SSH_AUTHORIZED_KEYS_INDENTED}

bootcmd:
  - |
    if [ ! -f /etc/.rpi-hostname-set ]; then
      SERIAL=$(awk '/^Serial/ {print $3}' /proc/cpuinfo)
      SUFFIX=$(echo "${SERIAL:-unknown}" | tail -c 7)
      NEW_HOST="rpi-${SUFFIX}"
      echo "$NEW_HOST" > /etc/hostname
      hostname "$NEW_HOST"
      if grep -q '^127\.0\.1\.1' /etc/hosts; then
        sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t$NEW_HOST/" /etc/hosts
      else
        echo -e "127.0.1.1\t$NEW_HOST" >> /etc/hosts
      fi
      touch /etc/.rpi-hostname-set
    fi

runcmd:
  - install -m 0644 /boot/firmware/role-setup.service /etc/systemd/system/role-setup.service
  - systemctl daemon-reload
  - systemctl enable role-setup.service
  - systemctl start role-setup.service
  # role-setup progress log symlink: /var/log/role-setup.log (the unit's
  # StandardOutput/StandardError target) surfaces in the user's home dir so
  # provisioning status is easy to find from the first SSH session. The log
  # itself is root-owned (unit appends as root); the link is user-owned.
  - ln -sf /var/log/role-setup.log /home/${PI_USERNAME}/role-setup.log
  - chown -h ${PI_USERNAME}:${PI_USERNAME} /home/${PI_USERNAME}/role-setup.log
  # Diagnostics: write cloud-init status + recent logs to the FAT bootfs
  # partition so they're readable from macOS when the card is re-inserted.
  # Helps diagnose why SSH/WiFi didn't come up on Lite images.
  - |
    (
      echo "=== cloud-init status ==="
      cloud-init status --long 2>&1
      echo
      echo "=== cloud-init services ==="
      systemctl status cloud-init-local.service cloud-init.service cloud-config.service cloud-final.service --no-pager 2>&1
      echo
      echo "=== ssh service ==="
      systemctl status ssh --no-pager 2>&1
      echo
      echo "=== network interfaces ==="
      ip -br addr 2>&1
      echo
      echo "=== cloud-init log tail ==="
      tail -100 /var/log/cloud-init.log 2>&1
      echo
      echo "=== cloud-init-output log tail ==="
      tail -100 /var/log/cloud-init-output.log 2>&1
    ) > /boot/firmware/cloud-init-debug.log 2>&1 || true
